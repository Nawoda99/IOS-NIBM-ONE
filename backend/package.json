{
  "name": "nibm-one-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1",
    "device:read": "node scripts/read-device.js",
    "postinstall": "patch-package",
    "test:mysql": "node scripts/run-mysql-check.js",
    "employee:create": "node scripts/create-employee.js",
    "admin:grant": "node scripts/grant-admin.js",
    "reference:import": "node scripts/import-reference-data.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "node-zklib": "1.3.0",
    "patch-package": "^8.0.1",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
